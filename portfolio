<style>
  :root{
    --bg:#12161A;
    --panel:#1B2126;
    --panel-raised:#212930;
    --line:#2E373F;
    --text:#E9EDEF;
    --text-muted:#8B96A0;
    --amber:#F2A93B;
    --amber-dim:#8A6526;
    --teal:#4FB6A8;
    --danger:#D9634A;
    --display:'Oswald',sans-serif;
    --body:'Inter',sans-serif;
    --mono:'IBM Plex Mono',monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--body);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
  }

  a{color:inherit;}
  ::selection{background:var(--amber); color:#14181C;}

  .grid-bg{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      linear-gradient(rgba(255,255,255,0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.028) 1px, transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 90%);
  }

  .wrap{max-width:1080px; margin:0 auto; padding:0 32px; position:relative; z-index:1;}

  :focus-visible{outline:2px solid var(--teal); outline-offset:2px;}

  /* ---------- Header / nav ---------- */
  header.site{
    position:sticky; top:0; z-index:50;
    background:rgba(18,22,26,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    max-width:1080px; margin:0 auto; padding:16px 32px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
  }
  .nav-id{
    font-family:var(--mono); font-size:12px; letter-spacing:0.08em; color:var(--text-muted);
    display:flex; align-items:center; gap:10px;
  }
  .nav-id .dot{width:7px; height:7px; border-radius:50%; background:var(--amber); box-shadow:0 0 8px var(--amber); animation:pulse 2.4s infinite;}
  @keyframes pulse{0%,100%{opacity:1;} 50%{opacity:0.35;}}
  nav.links{display:flex; gap:22px; align-items:center; font-family:var(--mono); font-size:12px; letter-spacing:0.06em;}
  nav.links a{color:var(--text-muted); text-decoration:none; transition:color 0.2s;}
  nav.links a:hover{color:var(--amber);}
  .nav-resume{
    border:1px solid var(--line); padding:7px 14px; border-radius:2px; color:var(--teal) !important;
    transition:border-color 0.2s;
  }
  .nav-resume:hover{border-color:var(--teal);}

  /* ---------- Hero ---------- */
  .hero{padding:88px 0 64px; position:relative;}
  .eyebrow{
    font-family:var(--mono); font-size:12px; letter-spacing:0.14em; color:var(--amber);
    text-transform:uppercase; margin-bottom:22px; display:flex; align-items:center; gap:10px;
  }
  .eyebrow::before{content:''; width:24px; height:1px; background:var(--amber);}
  h1.title{
    font-family:var(--display); font-weight:600; font-size:clamp(40px,6vw,68px);
    line-height:1.04; letter-spacing:-0.01em; text-transform:uppercase; max-width:780px;
  }
  h1.title .accent{color:var(--amber);}
  .subtitle{
    margin-top:22px; font-size:18px; color:var(--text-muted); max-width:600px; line-height:1.65;
  }
  .subtitle strong{color:var(--text); font-weight:600;}
  .hero-actions{display:flex; gap:14px; margin-top:34px; flex-wrap:wrap;}
  .btn{
    font-family:var(--mono); font-size:12.5px; letter-spacing:0.05em; text-decoration:none;
    padding:12px 20px; border-radius:2px; display:inline-flex; align-items:center; gap:8px;
    transition:all 0.2s; border:1px solid transparent; cursor:pointer; background:none;
  }
  .btn-primary{background:var(--amber); color:#161A1E; font-weight:600;}
  .btn-primary:hover{background:#ffbf5c;}
  .btn-ghost{border-color:var(--line); color:var(--text);}
  .btn-ghost:hover{border-color:var(--teal); color:var(--teal);}
  .btn-sm{padding:8px 14px; font-size:11.5px;}

  /* ---------- Console readout strip ---------- */
  .console{
    margin-top:56px; border:1px solid var(--line); background:var(--panel);
    border-radius:3px; overflow:hidden;
  }
  .console-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 18px; border-bottom:1px solid var(--line);
    font-family:var(--mono); font-size:11px; letter-spacing:0.08em; color:var(--text-muted);
  }
  .console-head .lights{display:flex; gap:6px;}
  .console-head .lights span{width:7px; height:7px; border-radius:50%; background:var(--line);}
  .console-head .lights span:nth-child(1){background:#5a4028;}
  .console-head .lights span:nth-child(2){background:#3c4a3f;}
  .console-head .lights span:nth-child(3){background:var(--teal); opacity:0.6;}
  .readout-grid{
    display:grid; grid-template-columns:repeat(4,1fr);
  }
  .readout{
    padding:22px 18px; border-right:1px solid var(--line);
    display:flex; flex-direction:column; gap:6px;
  }
  .readout:last-child{border-right:none;}
  .readout .val{
    font-family:var(--mono); font-size:clamp(22px,3vw,30px); font-weight:500; color:var(--amber);
    font-variant-numeric:tabular-nums;
  }
  .readout .lbl{font-size:11.5px; color:var(--text-muted); letter-spacing:0.02em;}
  @media (max-width:720px){
    .readout-grid{grid-template-columns:repeat(2,1fr);}
    .readout:nth-child(2){border-right:none;}
  }

  /* ---------- Section shell ---------- */
  section{padding:76px 0;}
  section + section{border-top:1px solid var(--line);}
  .section-head{
    display:flex; align-items:baseline; gap:16px; margin-bottom:40px; flex-wrap:wrap;
  }
  .section-tag{
    font-family:var(--mono); font-size:12px; color:var(--amber); letter-spacing:0.1em; white-space:nowrap;
  }
  .section-title{
    font-family:var(--display); font-size:clamp(24px,3vw,32px); text-transform:uppercase;
    letter-spacing:0.01em; font-weight:600;
  }
  .section-line{flex:1; height:1px; background:var(--line); min-width:40px;}
  .section-sub{font-size:14.5px; color:var(--text-muted); max-width:640px; margin:-24px 0 36px;}

  /* ---------- Competencies ---------- */
  .panels{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  .panel{background:var(--panel); padding:26px 24px;}
  .panel h3{
    font-family:var(--mono); font-size:12px; color:var(--teal); letter-spacing:0.08em;
    margin-bottom:16px; text-transform:uppercase;
  }
  .panel ul{list-style:none;}
  .panel li{
    font-size:14.5px; color:var(--text); padding:7px 0; border-top:1px dashed var(--line);
    display:flex; align-items:baseline; gap:8px;
  }
  .panel li:first-child{border-top:none;}
  .panel li::before{content:'▸'; color:var(--amber-dim); font-size:11px;}
  @media (max-width:760px){.panels{grid-template-columns:1fr;}}

  /* ---------- How I Work ---------- */
  .process-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  .process-card{background:var(--panel); padding:24px 20px; position:relative;}
  .process-num{font-family:var(--mono); font-size:11px; color:var(--amber-dim); letter-spacing:0.1em; margin-bottom:14px;}
  .process-card h4{font-family:var(--display); font-size:16px; text-transform:uppercase; letter-spacing:0.02em; margin-bottom:10px;}
  .process-card p{font-size:13.5px; color:var(--text-muted); line-height:1.55;}
  @media (max-width:900px){.process-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:520px){.process-grid{grid-template-columns:1fr;}}

  /* ---------- Filters ---------- */
  .filter-row{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:32px;}
  .filter-btn{
    font-family:var(--mono); font-size:11.5px; letter-spacing:0.05em; padding:8px 16px;
    border:1px solid var(--line); border-radius:20px; background:var(--panel); color:var(--text-muted);
    cursor:pointer; transition:all 0.2s;
  }
  .filter-btn:hover{border-color:var(--teal); color:var(--teal);}
  .filter-btn.active{background:var(--amber); border-color:var(--amber); color:#161A1E; font-weight:600;}
  .job[hidden]{display:none;}

  /* ---------- Flagship case study ---------- */
  .flagship{
    border:1px solid var(--amber-dim); background:var(--panel); border-radius:3px;
    margin-bottom:44px; overflow:hidden;
  }
  .flagship-tag{
    background:var(--amber); color:#161A1E; font-family:var(--mono); font-size:11px;
    letter-spacing:0.1em; padding:6px 16px; display:inline-block; font-weight:600;
  }
  .flagship-head{padding:26px 28px 8px;}
  .flagship-head .job-role{font-size:22px;}
  .flagship-body{padding:8px 28px 28px;}

  /* Flow diagram (illustrative process visual) */
  .flow{
    display:flex; align-items:stretch; gap:0; margin:22px 0 26px; flex-wrap:wrap;
    border:1px solid var(--line); border-radius:3px; overflow:hidden;
  }
  .flow-step{
    flex:1; min-width:110px; padding:16px 14px; background:var(--panel-raised);
    border-right:1px dashed var(--line); position:relative; text-align:center;
  }
  .flow-step:last-child{border-right:none;}
  .flow-step .fnum{font-family:var(--mono); font-size:10px; color:var(--amber-dim); letter-spacing:0.08em;}
  .flow-step .flbl{font-family:var(--display); font-size:13px; text-transform:uppercase; letter-spacing:0.02em; margin-top:6px;}
  .flow-step::after{
    content:'→'; position:absolute; right:-9px; top:50%; transform:translateY(-50%);
    color:var(--amber); font-size:14px; z-index:2; background:var(--bg); width:16px; height:16px;
    display:flex; align-items:center; justify-content:center;
  }
  .flow-step:last-child::after{content:'';}
  @media (max-width:640px){
    .flow{flex-direction:column;}
    .flow-step{border-right:none; border-bottom:1px dashed var(--line); text-align:left; display:flex; align-items:center; gap:10px;}
    .flow-step:last-child{border-bottom:none;}
    .flow-step::after{content:'↓'; right:auto; left:14px; top:auto; bottom:-9px; transform:none;}
    .flow-step:last-child::after{content:'';}
  }

  .cs-grid{display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:6px;}
  .cs-block h4{
    font-family:var(--mono); font-size:11.5px; color:var(--teal); letter-spacing:0.08em;
    text-transform:uppercase; margin-bottom:10px;
  }
  .cs-block p, .cs-block li{font-size:14.5px; color:#CBD3D8; line-height:1.65;}
  .cs-block ul{list-style:none;}
  .cs-block li{position:relative; padding-left:18px; margin-bottom:6px;}
  .cs-block li::before{content:'—'; position:absolute; left:0; color:var(--amber);}
  @media (max-width:700px){.cs-grid{grid-template-columns:1fr;}}

  .outcome-strip{display:flex; gap:1px; background:var(--line); border:1px solid var(--line); margin-top:24px; flex-wrap:wrap;}
  .outcome-cell{flex:1; min-width:140px; background:var(--panel-raised); padding:16px; text-align:center;}
  .outcome-cell .v{font-family:var(--mono); color:var(--amber); font-size:22px; font-weight:500;}
  .outcome-cell .l{font-size:11.5px; color:var(--text-muted); margin-top:4px;}

  /* ---------- Experience / case studies ---------- */
  .job{
    border:1px solid var(--line); background:var(--panel); border-radius:3px;
    margin-bottom:20px; overflow:hidden; transition:opacity 0.25s ease;
  }
  .job-head{
    padding:22px 26px; display:flex; justify-content:space-between; align-items:flex-start;
    gap:20px; flex-wrap:wrap; background:var(--panel-raised); border-bottom:1px solid var(--line);
  }
  .job-role{font-family:var(--display); font-size:19px; text-transform:uppercase; letter-spacing:0.01em;}
  .job-org{color:var(--teal); font-size:14px; margin-top:3px;}
  .job-meta{
    font-family:var(--mono); font-size:11.5px; color:var(--text-muted); text-align:right;
    letter-spacing:0.03em; white-space:nowrap;
  }
  .job-tags{display:flex; gap:6px; margin-top:8px; flex-wrap:wrap;}
  .job-tag{
    font-family:var(--mono); font-size:10px; letter-spacing:0.05em; padding:3px 9px;
    border:1px solid var(--line); border-radius:12px; color:var(--text-muted);
  }
  .job-body{padding:22px 26px;}
  .job-body .problem-line{
    font-size:14px; color:var(--text-muted); font-style:italic; margin-bottom:14px;
    padding-left:14px; border-left:2px solid var(--amber-dim);
  }
  .job-body ul{list-style:none;}
  .job-body li{
    position:relative; padding:8px 0 8px 20px; font-size:14.5px; color:#CBD3D8; border-top:1px solid rgba(255,255,255,0.04);
  }
  .job-body li:first-child{border-top:none;}
  .job-body li::before{content:'—'; position:absolute; left:0; color:var(--amber);}
  .job-body li b{color:var(--amber); font-weight:600;}

  .subproject{margin-top:18px; padding-top:18px; border-top:1px dashed var(--line);}
  .subproject:first-of-type{margin-top:6px;}
  .subproject-title{
    font-family:var(--mono); font-size:12.5px; color:var(--text); letter-spacing:0.03em;
    margin-bottom:8px; display:flex; align-items:center; gap:8px;
  }
  .subproject-title .zone{color:var(--amber-dim);}

  /* ---------- Testimonial placeholder ---------- */
  .evidence-row{display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;}
  .evidence-link{
    font-family:var(--mono); font-size:11.5px; letter-spacing:0.03em; padding:7px 13px;
    border:1px solid var(--teal); border-radius:2px; color:var(--teal); text-decoration:none;
    display:inline-flex; align-items:center; gap:6px; transition:all 0.2s; background:rgba(79,182,168,0.06);
  }
  .evidence-link:hover{background:var(--teal); color:#0F1416;}

  .sample-card{
    border:1px solid var(--line); background:var(--panel); border-radius:3px; padding:24px 26px;
    display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap;
  }
  .sample-card .stitle{font-family:var(--display); font-size:16px; text-transform:uppercase; letter-spacing:0.02em;}
  .sample-card .sdesc{font-size:13.5px; color:var(--text-muted); margin-top:6px; max-width:520px;}

  .testimonial{
    border:1px solid var(--teal); border-radius:3px; padding:30px 28px; background:var(--panel);
    position:relative;
  }
  .testimonial-flag{
    font-family:var(--mono); font-size:10.5px; letter-spacing:0.08em; color:var(--teal);
    text-transform:uppercase; margin-bottom:14px; display:block;
  }
  .testimonial q{font-family:var(--display); font-size:20px; font-style:normal; text-transform:none; line-height:1.4; color:var(--text); display:block;}
  .testimonial-attr{margin-top:16px; font-family:var(--mono); font-size:12px; color:var(--text-muted);}

  /* ---------- Tools ---------- */
  .tradeoff{
    border:1px solid var(--amber-dim); background:rgba(242,169,59,0.05); border-radius:3px;
    padding:18px 22px; margin-top:24px; display:flex; gap:14px; align-items:flex-start;
  }
  .tradeoff .ticon{font-size:18px; line-height:1; margin-top:1px;}
  .tradeoff h4{font-family:var(--mono); font-size:11.5px; color:var(--amber); letter-spacing:0.08em; text-transform:uppercase; margin-bottom:6px;}
  .tradeoff p{font-size:14px; color:#CBD3D8; line-height:1.6;}

  .moscow-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line); border:1px solid var(--line); margin-top:10px;}
  .moscow-cell{background:var(--panel-raised); padding:12px 12px;}
  .moscow-cell .mtag{font-family:var(--mono); font-size:10px; letter-spacing:0.08em; margin-bottom:6px; display:block;}
  .moscow-cell.must .mtag{color:var(--danger);}
  .moscow-cell.should .mtag{color:var(--amber);}
  .moscow-cell.could .mtag{color:var(--teal);}
  .moscow-cell.wont .mtag{color:var(--text-muted);}
  .moscow-cell p{font-size:12px; color:var(--text-muted); line-height:1.4;}
  @media (max-width:640px){.moscow-grid{grid-template-columns:repeat(2,1fr);}}

  .tool-strip{display:flex; flex-wrap:wrap; gap:10px;}
  .tool-chip{
    font-family:var(--mono); font-size:12.5px; padding:8px 14px; border:1px solid var(--line);
    border-radius:20px; color:var(--text-muted); transition:all 0.2s; background:var(--panel);
  }
  .tool-chip:hover{border-color:var(--teal); color:var(--teal);}

  /* ---------- Education ---------- */
  .edu-grid{display:grid; grid-template-columns:1.2fr 1fr; gap:1px; background:var(--line); border:1px solid var(--line);}
  .edu-col{background:var(--panel); padding:26px 24px;}
  .edu-col h3{font-family:var(--mono); font-size:12px; color:var(--teal); letter-spacing:0.08em; margin-bottom:16px; text-transform:uppercase;}
  .edu-item{padding:10px 0; border-top:1px dashed var(--line);}
  .edu-item:first-child{border-top:none;}
  .edu-item .deg{font-weight:600; font-size:14.5px;}
  .edu-item .inst{font-size:13.5px; color:var(--text-muted); margin-top:2px;}
  @media (max-width:760px){.edu-grid{grid-template-columns:1fr;}}

  /* ---------- Footer ---------- */
  footer{padding:60px 0 80px; text-align:center;}
  footer .close-title{
    font-family:var(--display); font-size:clamp(28px,4vw,42px); text-transform:uppercase; margin-bottom:16px;
  }
  footer p{color:var(--text-muted); max-width:480px; margin:0 auto 28px;}
  .contact-row{display:flex; gap:14px; justify-content:center; flex-wrap:wrap;}
  .foot-meta{margin-top:56px; font-family:var(--mono); font-size:11px; color:#5A6570; letter-spacing:0.05em;}

  .reveal{opacity:0; transform:translateY(14px); transition:opacity 0.6s ease, transform 0.6s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}
</style>
</head>
